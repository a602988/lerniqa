# Local PostgreSQL values are optional. The application defaults to the
# repository's isolated cluster created by `npm run db:local:ensure`.
#
# LOCAL_PG_SOCKET=/absolute/path/to/lerniqa/local-data/postgres-socket
# LOCAL_PG_PORT=55432
# LOCAL_PG_DATABASE=lerniqa_local
# LOCAL_PG_USER=your-local-operating-system-user

# Synology MailPlus SMTP is intentionally disabled until these Lerniqa-only
# values are approved and configured. Never copy credentials into this file.
# Port 465 + secure=true follows the current ERP MailPlus transport defaults.
# LERNIQA_MAIL_SMTP_HOST=mail.example.com
# LERNIQA_MAIL_SMTP_PORT=465
# LERNIQA_MAIL_SMTP_SECURE=true
# LERNIQA_MAIL_SMTP_USER=mailer@example.com
# LERNIQA_MAIL_SMTP_PASSWORD=configure-in-secret-store
# LERNIQA_MAIL_FROM_NAME=Lerniqa
# LERNIQA_MAIL_FROM_ADDRESS=no-reply@example.com
