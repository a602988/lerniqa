# Local PostgreSQL values are optional. The application defaults to the
# repository's isolated cluster created by `npm run db:local:ensure`.
#
# LOCAL_PG_SOCKET=/absolute/path/to/lerniqa/local-data/postgres-socket
# LOCAL_PG_PORT=55432
# LOCAL_PG_DATABASE=lerniqa_local
# LOCAL_PG_USER=your-local-operating-system-user

# Google Identity Services web client ID. Add localhost and each HTTPS site
# origin to the same OAuth client in Google Cloud before enabling quick registration.
# GOOGLE_OAUTH_CLIENT_ID=000000000000-example.apps.googleusercontent.com
# Google Picker API key and Cloud project number. Restrict the key to the
# Lerniqa origins, https://docs.google.com/*, Google Picker API and Drive API.
# GOOGLE_DRIVE_PICKER_API_KEY=configure-in-deployment-environment
# GOOGLE_DRIVE_APP_ID=000000000000
# LINE Login Web app channel。Callback URL 必須包含
# /api/v1/auth/social/line/callback。
# LINE_CHANNEL_ID=1234567890
# LINE_CHANNEL_SECRET=configure-in-secret-store
# Meta App 的 Facebook Login callback URL 必須包含
# /api/v1/auth/social/facebook/callback。
# FACEBOOK_APP_ID=1234567890
# FACEBOOK_APP_SECRET=configure-in-secret-store

# 本地 AI 與 ERP 使用相同的 Ollama 設定名稱。手寫內容含學習者作答，
# 因此 Lerniqa 只接受本機 loopback，不會把圖片送到遠端 URL。
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.8:27b
# OLLAMA_KEEP_ALIVE=30m
# PP-OCRv5 與 Apple Vision 不使用遠端 API。先執行 npm run handwriting:setup
# 建立 local-data/handwriting-python 並預載固定版本的本機辨識模型。

# Synology MailPlus SMTP is intentionally disabled until these Lerniqa-only
# values are approved and configured. Never copy credentials into this file.
# Port 465 + secure=true follows the current ERP MailPlus transport defaults.
# LERNIQA_MAIL_SMTP_HOST=mail.example.com
# LERNIQA_MAIL_SMTP_PORT=465
# LERNIQA_MAIL_SMTP_SECURE=true
# SMTP username may differ from the From address; confirm it with the mail
# administrator instead of inferring it from the selected sender identity.
# LERNIQA_MAIL_SMTP_USER=confirm-with-mail-administrator
# LERNIQA_MAIL_SMTP_PASSWORD=configure-in-secret-store
# LERNIQA_MAIL_FROM_NAME=Lerniqa
# LERNIQA_MAIL_FROM_ADDRESS=jean@mail.minmax.biz
