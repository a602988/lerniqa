{
  "name": "lerniqa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run test:runtime-guardrails",
    "dev": "LERNIQA_NEXT_DIST_DIR=.next-dev next dev -p 3500 --hostname 127.0.0.1",
    "prebuild": "npm run test:runtime-guardrails",
    "build": "LERNIQA_NEXT_DIST_DIR=.next-build next build",
    "preadmin:dev": "npm run test:runtime-guardrails && npm run admin:db:status",
    "admin:dev": "NEXT_TELEMETRY_DISABLED=1 LERNIQA_NEXT_DIST_DIR=.next-admin LOCAL_PG_SOCKET=$PWD/local-data/admin-e2e/socket LOCAL_PG_PORT=55439 LOCAL_PG_DATABASE=lerniqa_admin_e2e next dev -H 127.0.0.1 -p 3617",
    "preadmin:build": "npm run test:runtime-guardrails && npm run admin:db:status",
    "admin:build": "NEXT_TELEMETRY_DISABLED=1 LERNIQA_NEXT_DIST_DIR=.next-admin-build LOCAL_PG_SOCKET=$PWD/local-data/admin-e2e/socket LOCAL_PG_PORT=55439 LOCAL_PG_DATABASE=lerniqa_admin_e2e next build",
    "preadmin:start": "npm run test:runtime-guardrails && npm run admin:db:status",
    "admin:start": "NEXT_TELEMETRY_DISABLED=1 LERNIQA_NEXT_DIST_DIR=.next-admin-build LOCAL_PG_SOCKET=$PWD/local-data/admin-e2e/socket LOCAL_PG_PORT=55439 LOCAL_PG_DATABASE=lerniqa_admin_e2e next start -H 127.0.0.1 -p 3617",
    "admin:db:init": "sh scripts/admin-postgres.sh init",
    "admin:db:start": "sh scripts/admin-postgres.sh start",
    "admin:db:status": "sh scripts/admin-postgres.sh status",
    "admin:db:migrate": "sh scripts/admin-postgres.sh migrate",
    "admin:db:ensure": "sh scripts/admin-postgres.sh ensure",
    "admin:db:stop": "sh scripts/admin-postgres.sh stop",
    "db:local:init": "sh scripts/local-postgres.sh init",
    "db:local:start": "sh scripts/local-postgres.sh start",
    "db:local:stop": "sh scripts/local-postgres.sh stop",
    "db:local:status": "sh scripts/local-postgres.sh status",
    "db:local:migrate": "sh scripts/local-postgres.sh migrate",
    "db:local:ensure": "sh scripts/local-postgres.sh ensure",
    "db:local:backup": "sh scripts/backup-local-data.sh",
    "predb:import:hanlin": "npm run test:import-preflight",
    "db:import:hanlin": "node scripts/import-hanlin-chinese-postgres.mjs",
    "db:test": "node scripts/with-local-postgres-test-lock.mjs -- sh scripts/verify-database-migrations.sh",
    "test:import-preflight": "node --test tests/hanlin-import-guardrails.test.mjs",
    "test:answer-chain": "node --test tests/hanlin-answer-chain.test.mjs && node scripts/verify-hanlin-answer-chain.mjs",
    "test:import-ownership": "node scripts/with-local-postgres-test-lock.mjs -- node scripts/run-hanlin-import-ownership-isolated.mjs",
    "test:auth": "node --no-warnings --experimental-strip-types --test tests/auth-core.test.ts",
    "test:admin": "node --no-warnings --experimental-strip-types --test tests/admin-input.test.ts tests/admin-account-handler.test.ts tests/admin-reporting.test.ts tests/admin-repository.test.ts tests/admin-http.test.ts tests/admin-view-model.test.ts tests/admin-asset-repository.test.ts tests/admin-asset-handler.test.ts tests/admin-read-snapshot.test.ts tests/admin-report-repository.test.ts tests/admin-report-view.test.ts tests/admin-mutation-security.test.ts tests/admin-mutation-handler.test.ts tests/admin-mutation-receipts.test.ts tests/admin-question-mutation.test.ts tests/admin-question-mutation-delivery.test.ts tests/admin-question-read-handler.test.ts tests/admin-question-relation-review.test.ts tests/admin-subscription-catalog.test.ts tests/admin-return-path.test.ts tests/postgres-read-transaction.test.ts",
    "test:mail": "node --no-warnings --experimental-strip-types --test tests/mail-service.test.mjs",
    "test:email-verification": "node --no-warnings --experimental-strip-types --test tests/email-verification.test.ts",
    "test:account-recovery": "node --no-warnings --experimental-strip-types --test tests/account-recovery.test.ts",
    "questions:enrich": "node scripts/enrich-question-bank.mjs",
    "questions:relations": "node scripts/analyze-question-relations.mjs",
    "teaching-source:smoke": "local-data/handwriting-python/bin/python scripts/smoke-teaching-source-ocr.py",
    "test:question-enrichment": "node --test tests/question-enrichment.test.mjs tests/question-relation-analysis.test.mjs",
    "handwriting:worker": "node scripts/process-handwriting-analysis.mjs",
    "handwriting:setup": "sh scripts/setup-handwriting-ocr.sh",
    "handwriting:smoke": "node scripts/smoke-handwriting-analysis.mjs --manifest tests/fixtures/handwriting-ai-synthetic/manifest.json --png-dir tests/fixtures/handwriting-ai-synthetic/png",
    "handwriting:smoke:hybrid": "npm run handwriting:smoke -- --execute --hybrid",
    "test:handwriting-ai": "node --test tests/handwriting-analysis-worker.test.mjs",
    "test:answer-disclosure": "node --test tests/local-practice-answer-disclosure.test.mjs",
    "test:handwriting": "node --no-warnings --experimental-strip-types --test tests/handwriting-persistence.test.ts",
    "test:local-backup": "node --test tests/local-data-backup.test.mjs",
    "test:local-practice": "node scripts/with-local-postgres-test-lock.mjs -- node scripts/run-local-practice-isolated.mjs",
    "test:learning-books": "node --no-warnings --experimental-strip-types --test tests/account-return-path.test.ts tests/learning-book-api.test.mjs tests/learning-book-browser-migration.test.mjs tests/learning-book-sessions.test.mjs",
    "test:learning-books:db": "node scripts/with-local-postgres-test-lock.mjs -- node --test tests/learning-book-postgres.test.mjs",
    "test:runtime-guardrails": "node --test tests/runtime-guardrails.test.mjs tests/local-postgres-test-lock.test.mjs tests/local-postgres-lifecycle-lock.test.mjs tests/hanlin-import-ownership-runner-signal.test.mjs tests/local-practice-spawn-error.test.mjs",
    "test": "node scripts/verify-question-fixtures.mjs",
    "start": "LERNIQA_NEXT_DIST_DIR=.next-build next start --hostname 127.0.0.1",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@keel-design/icons": "^0.0.4-test.4",
    "@keel-design/tailwind-config": "^0.0.5-test.3",
    "@keel-design/themes": "^0.2.0-test.6",
    "@keel-design/tokens": "^0.3.0-test.11",
    "@keel-design/ui": "^0.4.0-test.25",
    "@tailwindcss/postcss": "^4.2.1",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.2"
  }
}
